# Matugen template for btop, laid out like btop's built-in Default theme.
#
# Wallpaper accents (change with the wallpaper): titles, shortcuts, selection,
# box outlines, banners, and the network graphs.
# Fixed meanings (custom colors from config.toml, only tinted slightly towards
# the wallpaper): temperature, CPU and process load, and the memory and disk meters.
#
# Gradients run from low to high values, like the Default theme:
# start = <color>_container (dark), mid = <color>, end = a stronger or brighter version.
# Faint parts (dividers, empty meters, inactive text) use the dark surface and
# outline tones, which is what makes them look see-through in the Default theme.

# Main background, empty for terminal default
theme[main_bg]=""

# Text
theme[main_fg]="{{ colors.on_surface.default.hex }}"
theme[title]="{{ colors.on_surface.default.hex }}"
theme[hi_fg]="{{ colors.primary.default.hex }}"
theme[selected_bg]="{{ colors.primary_container.default.hex }}"
theme[selected_fg]="{{ colors.on_primary_container.default.hex }}"
theme[proc_misc]="{{ colors.tertiary.default.hex }}"

# Faint parts
theme[inactive_fg]="{{ colors.outline_variant.default.hex }}"
theme[graph_text]="{{ colors.outline_variant.default.hex | auto_lightness: 10.0 }}"
theme[meter_bg]="{{ colors.outline_variant.default.hex }}"
theme[div_line]="{{ colors.surface_container_highest.default.hex }}"

# Box outlines
theme[cpu_box]="{{ colors.primary_container.default.hex | auto_lightness: 10.0 }}"
theme[mem_box]="{{ colors.tertiary_container.default.hex | auto_lightness: 10.0 }}"
theme[net_box]="{{ colors.secondary_container.default.hex | auto_lightness: 10.0 }}"
theme[proc_box]="{{ colors.primary_container.default.hex | auto_lightness: 10.0 }}"

# Temperature: cool blue to hot pink
theme[temp_start]="{{ colors.dodgerblue.default.hex | auto_lightness: 15.0 }}"
theme[temp_mid]="{{ colors.blueviolet.default.hex | auto_lightness: 10.0 }}"
theme[temp_end]="{{ colors.deeppink.default.hex | auto_lightness: 15.0 }}"

# CPU load: green to yellow to red
theme[cpu_start]="{{ colors.springgreen.default.hex }}"
theme[cpu_mid]="{{ colors.yellow.default.hex }}"
theme[cpu_end]="{{ colors.red.default.hex | auto_lightness: 15.0 }}"

# Process CPU usage in the process list: same as CPU load
theme[process_start]="{{ colors.springgreen.default.hex }}"
theme[process_mid]="{{ colors.yellow.default.hex }}"
theme[process_end]="{{ colors.red.default.hex | auto_lightness: 15.0 }}"

# Memory and disk meters
theme[free_start]="{{ colors.chartreuse_container.default.hex }}"
theme[free_mid]="{{ colors.chartreuse.default.hex }}"
theme[free_end]="{{ colors.on_chartreuse_container.default.hex }}"

theme[cached_start]="{{ colors.dodgerblue_container.default.hex }}"
theme[cached_mid]="{{ colors.aqua.default.hex }}"
theme[cached_end]="{{ colors.dodgerblue.default.hex }}"

theme[available_start]="{{ colors.orange_container.default.hex }}"
theme[aavailable_mid]="{{ colors.orange.default.hex | auto_lightness: 15.0 }}"
theme[vailable_end]="{{ colors.yellow.default.hex }}"

theme[used_start]="{{ colors.red_container.default.hex }}"
theme[used_mid]="{{ colors.red.default.hex | auto_lightness: 15.0 }}"
theme[used_end]="{{ colors.lightcoral.default.hex }}"

# Network graphs: follow the wallpaper
theme[download_start]="{{ colors.primary_container.default.hex }}"
theme[download_mid]="{{ colors.primary.default.hex }}"
theme[download_end]="{{ colors.on_primary_container.default.hex }}"

theme[upload_start]="{{ colors.tertiary_container.default.hex }}"
theme[upload_mid]="{{ colors.tertiary.default.hex }}"
theme[upload_end]="{{ colors.on_tertiary_container.default.hex }}"

# Process list states: paused, following a process, and the info banner
theme[proc_pause_bg]="{{ colors.error_container.default.hex }}"
theme[proc_follow_bg]="{{ colors.secondary_container.default.hex }}"
theme[proc_banner_bg]="{{ colors.tertiary_container.default.hex }}"
theme[proc_banner_fg]="{{ colors.on_tertiary_container.default.hex }}"
theme[followed_bg]="{{ colors.secondary_container.default.hex }}"
theme[followed_fg]="{{ colors.on_secondary_container.default.hex }}"

