# Matugen template for btop, laid out like btop's built-in Default theme.
#
# Wallpaper accents (change with the wallpaper): titles, shortcuts, selection,
# box outlines, banners, and the network graphs.
# Fixed meanings (custom colors from config.toml, only tinted slightly towards
# the wallpaper): temperature, CPU and process load, and the memory and disk meters.
#
# Gradients run from low to high values, like the Default theme:
# start = <color>_container (dark), mid = <color>, end = a stronger or brighter version.
# Faint parts (dividers, empty meters, inactive text) use the dark surface and
# outline tones, which is what makes them look see-through in the Default theme.

# Main background, empty for terminal default
theme[main_bg]=""

# Text
theme[main_fg]="#e9e2d4"
theme[title]="#e9e2d4"
theme[hi_fg]="#ddc56e"
theme[selected_bg]="#544600"
theme[selected_fg]="#fbe187"
theme[proc_misc]="#aad0b1"

# Faint parts
theme[inactive_fg]="#4b4639"
theme[graph_text]="#68614f"
theme[meter_bg]="#4b4639"
theme[div_line]="#38352b"

# Box outlines
theme[cpu_box]="#877100"
theme[mem_box]="#406e4e"
theme[net_box]="#6f643c"
theme[proc_box]="#877100"

# Temperature: cool blue to hot pink
theme[temp_start]="#51a5f8"
theme[temp_mid]="#d48bec"
theme[temp_end]="#ff6767"

# CPU load: green to yellow to red
theme[cpu_start]="#aad290"
theme[cpu_mid]="#d5c871"
theme[cpu_end]="#ff8049"

# Process CPU usage in the process list: same as CPU load
theme[process_start]="#aad290"
theme[process_mid]="#d5c871"
theme[process_end]="#ff8049"

# Memory and disk meters
theme[free_start]="#404c09"
theme[free_mid]="#bfce7f"
theme[free_end]="#dbea98"

theme[cached_start]="#0f4a73"
theme[cached_mid]="#84d5c4"
theme[cached_end]="#9bcbfb"

theme[available_start]="#673d00"
theme[aavailable_mid]="#f79629"
theme[vailable_end]="#d5c871"

theme[used_start]="#713619"
theme[used_mid]="#ff8049"
theme[used_end]="#ffb5a0"

# Network graphs: follow the wallpaper
theme[download_start]="#544600"
theme[download_mid]="#ddc56e"
theme[download_end]="#fbe187"

theme[upload_start]="#2d4e37"
theme[upload_mid]="#aad0b1"
theme[upload_end]="#c6eccd"

# Process list states: paused, following a process, and the info banner
theme[proc_pause_bg]="#93000a"
theme[proc_follow_bg]="#4e462a"
theme[proc_banner_bg]="#2d4e37"
theme[proc_banner_fg]="#c6eccd"
theme[followed_bg]="#4e462a"
theme[followed_fg]="#efe2bc"

